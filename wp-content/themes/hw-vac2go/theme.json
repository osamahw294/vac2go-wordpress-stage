{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "HW Kadence Starter",
  "description": "Child overrides layered on top of the Kadence parent. Swap the PLACEHOLDER brand values per client (see comments in README.md).",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "customDuotone": false,
      "palette": [
        {
          "slug": "brand-primary",
          "color": "#e01f30",
          "name": "Brand Primary (Vac2Go red)"
        },
        {
          "slug": "brand-secondary",
          "color": "#1a1a1a",
          "name": "Brand Secondary (dark section bg)"
        },
        {
          "slug": "brand-accent",
          "color": "#dd3333",
          "name": "Brand Accent (button hover red)"
        },
        {
          "slug": "neutral-900",
          "color": "#2d2d2d",
          "name": "Neutral 900 — body text (usually keep)"
        },
        {
          "slug": "neutral-700",
          "color": "#3A424E",
          "name": "Neutral 700 — muted text (usually keep)"
        },
        {
          "slug": "neutral-400",
          "color": "#8B94A3",
          "name": "Neutral 400 — borders/placeholders (usually keep)"
        },
        {
          "slug": "neutral-100",
          "color": "#EEF1F5",
          "name": "Neutral 100 — surfaces/cards (usually keep)"
        },
        {
          "slug": "base-white",
          "color": "#FFFFFF",
          "name": "Base White — page background (usually keep)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "lineHeight": true,
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small",
          "fluid": false
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Medium",
          "fluid": false
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Large",
          "fluid": {
            "min": "1.125rem",
            "max": "1.25rem"
          }
        },
        {
          "slug": "x-large",
          "size": "1.75rem",
          "name": "Extra Large",
          "fluid": {
            "min": "1.5rem",
            "max": "1.75rem"
          }
        },
        {
          "slug": "xx-large",
          "size": "2.5rem",
          "name": "2X Large",
          "fluid": {
            "min": "2rem",
            "max": "2.5rem"
          }
        },
        {
          "slug": "huge",
          "size": "3.5rem",
          "name": "Huge (display)",
          "fluid": {
            "min": "2.5rem",
            "max": "3.5rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "customSpacingSize": true,
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "slug": "20",
          "size": "0.5rem",
          "name": "1 — X Small"
        },
        {
          "slug": "30",
          "size": "1rem",
          "name": "2 — Small"
        },
        {
          "slug": "40",
          "size": "1.5rem",
          "name": "3 — Medium"
        },
        {
          "slug": "50",
          "size": "2.5rem",
          "name": "4 — Large"
        },
        {
          "slug": "60",
          "size": "4rem",
          "name": "5 — X Large"
        },
        {
          "slug": "70",
          "size": "6rem",
          "name": "6 — XX Large"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base-white)",
      "text": "var(--wp--preset--color--neutral-900)"
    },
    "typography": {
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--brand-primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--brand-secondary)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--brand-primary)",
          "text": "var(--wp--preset--color--base-white)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--brand-secondary)",
            "text": "var(--wp--preset--color--base-white)"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--neutral-900)"
        },
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      }
    }
  }
}