# EditorConfig — https://editorconfig.org
# WordPress Coding Standards: tabs for indentation.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# PHP, JS, CSS follow WPCS: tabs.
[*.{php,js,css}]
indent_style = tab

# Data/markup files conventionally use spaces.
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
